layout(set = 1, binding = 6) uniform ShadowCalculationData
{
    mat4 worldToLightViewProj;
    mat4 worldToShadowMapProj;
}
shadowLight;

// per-draw: the 3D transmittance map this pass writes.
layout(set = 2, binding = 0, r8) uniform writeonly image3D transmittanceMap;

// per-draw depth-test set (set 3)
layout(set = 3, binding = 0) uniform sampler2D sunDepth;

#include "PNanoVDB.h"

#include "struct_Ray.comp"

#include "func_reconstructDepthDistanceInObjectLocalSpace.comp"

#include "volume_helpers.comp"

void forwardMarch(const ivec2 columnPixel, const float surfaceDepth)
{
    const ivec3 mapDims = imageSize(transmittanceMap);
    const int surfaceSlice = clamp(int(surfaceDepth * float(mapDims.z)), 0, mapDims.z);

    for (int z = 0; z < surfaceSlice; z++)
        imageStore(transmittanceMap, ivec3(columnPixel, z), vec4(1.0, 0.0, 0.0, 0.0));
}

void main()
{
    const ivec3 mapDims = imageSize(transmittanceMap);
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, mapDims.xy)))
        return;

    // this column's UV in light/shadow-map space -> sampled ground depth (NDC z)
    const vec2 uv = (vec2(px) + 0.5) / vec2(mapDims.xy);
    const float surfaceDepth = texture(sunDepth, uv).r;

    forwardMarch(px, surfaceDepth);
}