// functions for generating random float values

uint hash_u32(in uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

uint makeSeed(const in uvec2 pixel, const in uint frame, const in uint sampleIndex, const in uint dimension)
{
    uint seed = 0u;
    seed ^= pixel.x * 1973u;
    seed ^= pixel.y * 9277u;
    seed ^= frame * 26699u;
    seed ^= sampleIndex * 911u;
    seed ^= dimension * 3571u;
    return hash_u32(seed);
}

float rand01(in uint seed)
{
    return float(hash_u32(seed)) * (1.0 / 4294967296.0);
}
