            ]
        },
        {
            "name": "linux-debug-tsan-ninja",
            "displayName": "Linux Ninja (gcc) - Debug TSan",
            "inherits": [
                "ninja-linux-base",
                "cfg-tsan"
            ]
        },
        {
            "name": "linux-clang-debug-tsan-ninja",
            "displayName": "Linux Ninja (clang) - Debug TSan",
            "inherits": [
                "ninja-linux-clang-base",
                "cfg-tsan",
                "cfg-warnings"
            ]
        }
    ],
