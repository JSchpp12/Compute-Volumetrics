        {
            "name": "linux-debug-ninja",
            "displayName": "Linux Ninja (gcc) - Debug",
            "inherits": [
                "ninja-linux-base",
                "cfg-debug"
            ]
        },
        {
            "name": "linux-debug-h-ninja",
            "displayName": "Linux Ninja (gcc) - Debug Headless",
            "inherits": [
                "ninja-linux-base",
                "cfg-debug-headless"
