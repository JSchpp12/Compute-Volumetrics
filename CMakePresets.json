{
    "version": 6,
    "configurePresets": [
        {
            "name": "vcpkg",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/extern/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_ROOT": "${sourceDir}/extern/vcpkg"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "vcpkg",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            },
            "environment": {
                "VCPKG_VISUAL_STUDIO_PATH": "C:/Program Files/Microsoft Visual Studio/18/Community",
                "VCPKG_DEFAULT_TRIPLET": "x64-windows"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "vcpkg",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
            },
            "environment": {
                "VCPKG_DEFAULT_TRIPLET": "x64-linux-dynamic"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "msvc-base",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "gcc-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "clang-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            },
            "environment": {
                "CC": "clang",
                "CXX": "clang++"
            }
        },
        {
            "name": "ninja-msvc-base",
            "hidden": true,
            "inherits": "msvc-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}"
        },
        {
            "name": "ninja-linux-base",
            "hidden": true,
            "inherits": "gcc-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}"
        },
        {
            "name": "ninja-linux-clang-base",
            "hidden": true,
            "inherits": "clang-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}"
        },
        {
            "name": "x64-vs2026",
            "hidden": true,
            "inherits": "windows-base",
            "generator": "Visual Studio 18 2026",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}"
        },
        {
            "name": "cfg-debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HEADLESS": "OFF",
                "VCPKG_MANIFEST_FEATURES": "windowed",
                "BUILD_UNIT_TESTS": "ON"
            }
        },
        {
            "name": "cfg-debug-headless",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HEADLESS": "ON",
                "BUILD_UNIT_TESTS": "ON"
            }
        },
        {
            "name": "cfg-release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "HEADLESS": "OFF",
                "VCPKG_MANIFEST_FEATURES": "windowed",
                "BUILD_UNIT_TESTS": "OFF"
            }
        },
        {
            "name": "cfg-release-headless",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "HEADLESS": "ON",
                "BUILD_UNIT_TESTS": "OFF"
            }
        },
        {
            "name": "cfg-warnings",
            "hidden": true,
            "cacheVariables": {
                "STAR_ENABLE_WARNINGS": "ON"
            }
        },
        {
            "name": "cfg-relwithdebinfo",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "HEADLESS": "OFF",
                "VCPKG_MANIFEST_FEATURES": "windowed"
            }
        },
        {
            "name": "cfg-ubsan",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HEADLESS": "ON",
                "BUILD_UNIT_TESTS": "ON",
                "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g",
                "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=undefined"
            }
        },
        {
            "name": "cfg-asan-ubsan",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HEADLESS": "ON",
                "BUILD_UNIT_TESTS": "ON",
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "cfg-tsan",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HEADLESS": "ON",
                "BUILD_UNIT_TESTS": "ON",
                "CMAKE_C_FLAGS": "-fsanitize=thread -fno-sanitize-recover=all -fno-omit-frame-pointer -g",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-sanitize-recover=all -fno-omit-frame-pointer -g",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
            }
        },
        {
            "name": "x64-26-debug",
            "displayName": "VS 26 - Debug",
            "inherits": [
                "x64-vs2026",
                "cfg-debug"
            ]
        },
        {
            "name": "x64-26-debug-h",
            "displayName": "VS 26 - Debug Headless",
            "inherits": [
                "x64-vs2026",
                "cfg-debug-headless"
            ]
        },
        {
            "name": "x64-26-release",
            "displayName": "VS 26 - Release",
            "inherits": [
                "x64-vs2026",
                "cfg-release"
            ]
        },
        {
            "name": "x64-26-relwithdebinfo",
            "displayName": "VS 26 - RelWithDebInfo",
            "inherits": [
                "x64-vs2026",
                "cfg-relwithdebinfo"
            ]
        },
        {
            "name": "x64-26-release-h",
            "displayName": "VS 26 - Release Headless",
            "inherits": [
                "x64-vs2026",
                "cfg-release-headless"
            ]
        },
