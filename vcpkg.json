{
  "name": "compute-volumetrics",
  "version-string": "1.0.0",
  "dependencies": [
    "tbb",
    {
      "name": "openvdb",
      "features": [
        "nanovdb"
      ]
    },
    "abseil",
    "highway",
    "nlohmann-json",
    "stb",
    "blosc",
    "glm",
    "vulkan-memory-allocator",
    "basisu",
    "tinyobjloader",
    "boost-thread",
    "boost-lockfree",
    "boost-container",
    "boost-filesystem",
    "boost-log",
    {
      "name": "ktx",
      "features": [
        "vulkan"
      ]
    },
    {
      "name": "gdal",
      "default-features": false
    },
    {
      "name": "tiff",
      "features": [ "zstd" ]
    },
    "gtest"
  ],
  "features": {
    "windowed": {
      "description": "Enables installation of dependencies for windowing support",
      "dependencies": [
        "glfw3"
      ]
    }
  }
}
